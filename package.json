{
  "name": "plateia",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma de eventos e ingressos desenvolvida para o Desafio Elite Dev da Verzel.",
  "author": "Arthur Vinicius Carneiro Nunes",
  "license": "MIT",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0"
  }
}
